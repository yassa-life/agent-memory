{
  "antigravity-visual-memory": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python memory/memory_hook.py pre_invocation",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python memory/memory_hook.py post_tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
