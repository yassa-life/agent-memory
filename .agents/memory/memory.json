  "decisions": [
    {
      "id": 1,
      "title": "Adopt Visual Antigravity Memory System",
      "date": "2026-10-05",
      "rationale": "Avoid spending unnecessary context tokens repeatedly scanning the filesystem by reading memory.json first."
    },
    {
      "id": 2,
      "title": "Use project-local, agent-neutral memory",
      "rationale": "Portable metadata and explicit durable notes work across Codex, Antigravity, Gemini, and other agents without collecting private chat history.",
      "created_at": "2026-11-07T15:45:41+05:30"
    },
    {
      "id": 3,
      "title": "Use a resolved file relationship graph",
      "rationale": "Agents can query relevant neighboring files without loading the full repository or relying on opaque embeddings.",
      "created_at": "2026-11-08T11:55:59+05:30"
    },
    {
      "id": 4,
      "title": "Keep chat tracking explicit and summary-only",
      "rationale": "The product tracks useful conversation context without silently collecting or embedding private transcript text.",
      "created_at": "2026-11-08T11:56:00+05:30"
    }
  ],
